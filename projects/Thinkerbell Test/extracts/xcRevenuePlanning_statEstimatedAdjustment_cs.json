{
  "-name": "xcRevenuePlanning_statEstimatedAdjustment_cs",
  "-type": "CubeSlice",
  "comment": {
    "#cdata-section": "Retrieves the adjustment slice for the vFY to eventually delete the value from the Revenue Planning cube.\n\n20260713: Changed the filter Detail Revenue/accept/like/./onlyBases to Detail Revenue/accept/equal/Revenue/onlyBases and Detail Revenue/accept/equal/Probability/onlyBases to make sure that Organic and New Business is remaining in Adjustment.\n20260409: Introduced"
  },
  "connection": {
    "-nameref": "cgLocal_statThinkerbell_jc"
  },
  "query": {
    "-mode": "exclude",
    "-randomPaths": "false",
    "cube": {
      "-name": "Revenue Planning"
    },
    "filter": {
      "condition": [
        {
          "#cdata-section": "Estimate",
          "-dimension": "Version",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Base",
          "-dimension": "Scenario",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Probability",
          "-dimension": "Detail Revenue",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Revenue",
          "-dimension": "Detail Revenue",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Adjustment",
          "-dimension": "Measure",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "${vFY}",
          "-dimension": "Month",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        }
      ]
    }
  }
}
