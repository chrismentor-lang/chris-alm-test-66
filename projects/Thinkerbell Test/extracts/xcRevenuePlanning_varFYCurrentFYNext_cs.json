{
  "-name": "xcRevenuePlanning_varFYCurrentFYNext_cs",
  "-type": "CubeSlice",
  "comment": {
    "#cdata-section": "20260701: Introduced."
  },
  "connection": {
    "-nameref": "cgLocal_statThinkerbell_jc"
  },
  "query": {
    "-mode": "exclude",
    "-randomPaths": "false",
    "cube": {
      "-name": "Revenue Planning"
    },
    "filter": {
      "condition": [
        {
          "#cdata-section": "Estimate",
          "-dimension": "Version",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Revenue",
          "-dimension": "Detail Revenue",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "${vFYCurrent}",
          "-dimension": "Month",
          "-mode": "onlyNodes",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "${vFYNext}",
          "-dimension": "Month",
          "-mode": "onlyNodes",
          "-operator": "equal",
          "-type": "accept"
        }
      ]
    }
  }
}
