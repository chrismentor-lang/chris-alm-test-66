{
  "-name": "xcFTE_statPublicHoliday_cs",
  "-type": "CubeSlice",
  "comment": "Retrieves cube slice for the Public Holiday FTEs from the FTE cube.",
  "connection": {
    "-nameref": "cgLocal_statThinkerbell_jc"
  },
  "query": {
    "-mode": "exclude",
    "-randomPaths": "false",
    "cube": {
      "-name": "FTE"
    },
    "filter": {
      "condition": {
        "#text": "Public Holiday",
        "-dimension": "Detail FTE",
        "-mode": "onlyBases",
        "-operator": "equal",
        "-type": "accept"
      }
    }
  }
}
