            "-nameref": "column4"
          }
        },
        {
          "-name": "Year",
          "input": {
            "-nameref": "fx_Year"
          }
        },
        {
          "-name": "Month",
          "input": {
            "-nameref": "fx_Month"
          }
        },
        {
          "-name": "Day",
          "input": {
            "-nameref": "fx_Day"
          }
        },
        {
          "-name": "Time",
          "input": {
            "-nameref": "fx_Sec"
          }
        },
        {
          "-name": "Username",
          "input": {
            "-nameref": "fx_User"
          }
        },
        {
          "-name": "Report",
          "input": {
            "-nameref": "fx_FullPath"
          }
        }
      ]
    },
    "measures": {
      "-normalize": "Measure (Spreadsheet)",
      "-valuename": "#Value",
      "measure": {
        "-aggregate": "none",
        "-name": "Hits",
        "-type": "numeric",
        "input": {
          "-constant": "1"
        }
      }
    }
  }
}
