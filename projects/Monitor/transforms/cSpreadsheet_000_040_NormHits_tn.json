{
  "-name": "cSpreadsheet_000_040_NormHits_tn",
  "-type": "TableNormalization",
  "cache": "false",
  "ignoreEmpty": "false",
  "sources": {
    "source": {
      "-nameref": "cSpreadsheetLogs_000_030_FormatCore_ft"
    }
  },
  "target": {
    "coordinates": {
      "-keepSourceOrder": "false",
      "coordinate": [
        {
          "-name": "Machine",
