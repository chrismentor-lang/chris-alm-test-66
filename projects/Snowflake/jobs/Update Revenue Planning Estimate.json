      {
        "-name": "vJedoxFileName",
        "default": "RevenuePlanningEstimateRefresh"
      },
      {
        "-name": "vJedoxWinSCPFolder",
        "default": "Snowflake/Jedox/RevenuePlanningEstimateRefresh"
      },
      {
        "-name": "vSCD",
        "default": "0"
      },
      {
        "-name": "vJedoxSnowflakeTable",
        "default": "REVENUE_PLANNING_ESTIMATE_REFRESH"
      }
    ]
  }
}
