      },
      {
        "-input": "created"
      },
      {
        "-input": "created_by"
      },
      {
        "-input": "description"
      },
      {
        "-input": "id"
      },
      {
        "-input": "modified"
      },
      {
        "-input": "modified_by"
      },
      {
        "-input": "name"
      },
      {
        "-input": "project_count"
      },
      {
        "-input": "project_status"
      },
      {
        "-input": "sort_order"
      }
    ]
  },
  "query": {
    "loopElements": {
      "loopElement": "$"
    }
  }
}
