{
  "-name": "xjFloatTasks_statColumns_je",
  "-type": "Json",
  "cache": "false",
  "comment": {
    "#cdata-section": "Retrieving all individual tasks and their details from Float. \n\nUsed in Load fFloatEndpoint_000_000_varLoadMode_fl using the variable vFloatEndpoint"
  },
  "connection": {
    "-nameref": "crFloatTasks_varFloatTokenPage_rc"
  },
  "outputs": {
