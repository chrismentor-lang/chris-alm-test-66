{
  "-name": "xcRevenueTrackerVersion_statEstAct_ce",
  "-type": "Cube",
  "cache": "false",
  "comment": {
    "#cdata-section": "Runs On Demand\n\n20260710: Changed the filter Detail Revenue/accept/equal/Revenue By Client Head to Detail Revenue/accept/equal/By Client Head"
  },
  "connection": {
    "-nameref": "cgLocal_statThinkerbell_jc"
  },
  "query": {
    "-celltype": "both",
    "-drillthrough": "false",
    "-onlyBasisAsDefault": "false",
    "-useRules": "true",
    "-zeroSuppressionType": "excludeEmptyAndZero",
    "cube": {
      "-name": "Revenue Planning"
    },
    "filter": {
      "condition": [
        {
          "#cdata-section": "Estimate",
          "-dimension": "Version",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Actual",
          "-dimension": "Version",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Base",
          "-dimension": "Scenario",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": ".",
          "-dimension": "Month",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        },
        {
          "#cdata-section": ".",
          "-dimension": "Office",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        },
        {
          "#cdata-section": ".",
          "-dimension": "Job Type",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        },
        {
          "#cdata-section": ".",
          "-dimension": "Estimate",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        },
        {
          "#cdata-section": ".",
          "-dimension": "Client Head",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        },
        {
          "#cdata-section": ".",
          "-dimension": "Task Type",
          "-mode": "onlyBases",
          "-operator": "like",
          "-type": "accept"
        },
        {
          "#cdata-section": "{\"All Currencies Base Elements\": {}}",
          "-dimension": "Currency",
          "-mode": "onlyBases",
          "-operator": "subset",
          "-type": "accept"
        },
        {
          "#cdata-section": "By Client Head",
          "-dimension": "Detail Revenue",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Probability",
          "-dimension": "Detail Revenue",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Input",
          "-dimension": "Measure",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Adjustment",
          "-dimension": "Measure",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        }
      ]
    }
  }
}
