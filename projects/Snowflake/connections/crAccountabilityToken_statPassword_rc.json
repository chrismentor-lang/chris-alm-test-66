{
  "-name": "crAccountabilityToken_statPassword_rc",
  "-type": "Rest",
  "comment": {
    "#cdata-section": "Establishes connection with Accountability with username and password based on the tenantid TKB.\n\n20260518: Added tenantid due to changes in required Accountability parameters."
  },
  "headers": {
    "header": [
      {
        "#text": "application/json",
        "-name": "accept"
      },
      {
        "#text": "application/x-www-form-urlencoded",
        "-name": "content-type"
      }
    ]
  },
  "httpMethod": "POST",
  "ignoreCookiesPolicy": "false",
  "parameters": {
    "parameter": [
      {
        "#text": "password",
        "-name": "grant_type"
      },
      {
        "#text": "TKB",
        "-name": "tenantid"
      },
      {
        "#text": "minerva.svc@minerva.com.au",
        "-name": "username"
      },
      {
        "#text": "R6:VLm5Q}!n2=k\\",
        "-name": "password"
      }
    ]
  },
  "resource": {
    "#cdata-section": "https://api.accountabilityonesystem.com/v1/token"
  },
  "ssl": "verify"
}
