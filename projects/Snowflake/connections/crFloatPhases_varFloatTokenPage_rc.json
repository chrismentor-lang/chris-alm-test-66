{
  "-name": "crFloatPhases_varFloatTokenPage_rc",
  "-type": "Rest",
  "comment": {
    "#cdata-section": "20251212: Introduced"
  },
  "headers": {
    "header": [
      {
        "#text": "Bearer ${vFloatToken}",
        "-name": "Authorization"
      },
      {
        "#text": "application/json",
        "-name": "accept"
      }
    ]
  },
  "httpMethod": "GET",
  "ignoreCookiesPolicy": "false",
  "parameters": {
    "parameter": [
      {
        "#text": "200",
        "-name": "per-page"
      },
      {
        "#text": "${vFloatPage}",
        "-name": "page"
      },
      {
        "#text": "phase_tasks,phase_teams",
        "-name": "expand"
      }
    ]
  },
  "resource": {
    "#cdata-section": "https://api.float.com/v3/phases"
  },
  "ssl": "verify"
}
