{
  "-name": "crFloatAccounts_varFloatTokenPage_rc",
  "-type": "Rest",
  "comment": {
    "#cdata-section": "Connection to the accounts API to retrieve all the accounts in Float.\n\n20251210: Introduced"
  },
  "headers": {
    "header": [
      {
        "#text": "Bearer ${vFloatToken}",
        "-name": "Authorization"
      },
      {
        "#text": "application/json",
        "-name": "accept"
      }
    ]
  },
  "httpMethod": "GET",
  "ignoreCookiesPolicy": "false",
  "parameters": {
    "parameter": [
      {
        "#text": "200",
        "-name": "per-page"
      },
      {
        "#text": "${vFloatPage}",
        "-name": "page"
      }
    ]
  },
  "resource": {
    "#cdata-section": "https://api.float.com/v3/accounts"
  },
  "ssl": "verify"
}
