{
  "-name": "crAccountabilityEstimates_varAccessToken_rc",
  "-type": "Rest",
  "comment": {
    "#cdata-section": "20260213: Removed Modified From and Modified To because switching over to Full Load\n20260112: Added the parameter ModifiedFrom"
  },
  "credentials": {
    "token": {
      "-nameref": "coauthAccountability_statToken_oauthc"
    }
  },
  "headers": {
    "header": {
      "#text": "application/json",
      "-name": "accept"
    }
  },
  "httpMethod": "GET",
  "ignoreCookiesPolicy": "false",
  "parameters": {
    "parameter": [
      {
        "#text": "200",
        "-name": "Limit"
      },
      {
        "#text": "${vAccountabilityOffset}",
        "-name": "Offset"
      },
      {
        "#text": "${vAccountabilityModifiedFrom}",
        "-name": "ModifiedFrom"
      },
      {
        "#text": "${vAccountabilityModifiedTo}",
        "-name": "ModifiedTo"
      }
    ]
  },
  "resource": {
    "#cdata-section": "https://api.accountabilityonesystem.com/v1/Estimates"
  },
  "ssl": "verify"
}
