{
  "-name": "crAccountabilityGeneralLedgerTransactions_varAccessToken_rc",
  "-type": "Rest",
  "comment": "20260112: Added the parameter ModifiedFrom",
  "credentials": {
    "token": {
      "-nameref": "coauthAccountability_statToken_oauthc"
    }
  },
  "headers": {
    "header": {
      "#text": "application/json",
      "-name": "accept"
    }
  },
  "httpMethod": "GET",
  "ignoreCookiesPolicy": "false",
  "parameters": {
    "parameter": [
      {
        "#text": "200",
        "-name": "Limit"
      },
      {
        "#text": "${vAccountabilityOffset}",
        "-name": "Offset"
      },
      {
        "#text": "${vAccountabilityModifiedFrom}",
        "-name": "ModifiedFrom"
      },
      {
        "#text": "${vAccountabilityModifiedTo}",
        "-name": "ModifiedTo"
      }
    ]
  },
  "resource": "https://api.accountabilityonesystem.com/v1/GeneralLedgerTransactions",
  "ssl": "verify"
}
