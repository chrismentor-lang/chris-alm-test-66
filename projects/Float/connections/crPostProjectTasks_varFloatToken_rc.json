{
  "-name": "crPostProjectTasks_varFloatToken_rc",
  "-type": "Rest",
  "comment": {
    "#cdata-section": "Connection to the Project Tasks API in Float.\n\n20251212: Introduced"
  },
  "headers": {
    "header": [
      {
        "#text": "Bearer ${vFloatToken}",
        "-name": "Authorization"
      },
      {
        "#text": "application/json",
        "-name": "accept"
      },
      {
        "#text": "application/json",
        "-name": "Content-Type"
      }
    ]
  },
  "httpMethod": "POST",
  "ignoreCookiesPolicy": "false",
  "resource": {
    "#cdata-section": "https://api.float.com/v3/project-tasks"
  },
  "ssl": "verify"
}
