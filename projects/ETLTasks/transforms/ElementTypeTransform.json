{
  "-name": "ElementTypeTransform",
  "-type": "TableView",
  "conditions": {
    "condition": {
      "-nameref": ":type",
      "-operator": "equal",
      "-type": "accept",
      "-value": "${_elementType}"
    }
  },
  "sources": {
    "source": {
      "-format": "ncw",
      "-nameref": "Dimension_Filter_Extract"
    }
  }
}
