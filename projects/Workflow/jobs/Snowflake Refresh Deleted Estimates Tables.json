{
  "-name": "Snowflake Refresh Deleted Estimates Tables",
  "-type": "ExternalJob",
  "comment": {
    "#cdata-section": "Kicks of the refresh of the Accountability ESTIMATES_DELETED table via the Update Accountability Tables job in the Snowflake project."
  },
  "execution": {
    "-nameref": "Update Accountability Tables",
    "-type": "job"
  },
  "failStatus": "inherit",
  "project": {
    "#text": "Snowflake",
    "-scope": "Global"
  },
  "variables": {
    "variable": [
      {
        "-name": "vAccountabilityEndpoint",
        "default": "EstimatesDeleted"
      },
      {
        "-name": "vAccountabilityTable",
        "default": "ESTIMATES_DELETED"
      },
      {
        "-name": "vSnowflakeSchemaType",
        "default": "FULL"
      }
    ]
  }
}
