{
  "-name": "Snowflake Refresh Estimate Entries Tables",
  "-type": "ExternalJob",
  "comment": {
    "#cdata-section": "Kicks of the refresh of the Accountability ESTIMATE_ENTRIES table via the Update Accountability Tables job in the Snowflake project."
  },
  "execution": {
    "-nameref": "Update Accountability Tables",
    "-type": "job"
  },
  "failStatus": "inherit",
  "project": {
    "#text": "Snowflake",
    "-scope": "Global"
  },
  "variables": {
    "variable": [
      {
        "-name": "vAccountabilityEndpoint",
        "default": "EstimateEntries"
      },
      {
        "-name": "vAccountabilityTable ",
        "default": "ESTIMATE_ENTRIES"
      },
      {
        "-name": "vSnowflakeSchemaType",
        "default": "INCREMENTAL"
      }
    ]
  }
}
