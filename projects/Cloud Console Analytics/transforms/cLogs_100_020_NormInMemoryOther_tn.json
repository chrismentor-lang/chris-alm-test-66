{
  "-name": "cLogs_100_020_NormInMemoryOther_tn",
  "-type": "TableNormalization",
  "cache": "false",
  "comment": {
    "#cdata-section": "20230730: Changed source from cInMemoryLogs_100_010_FormatErrorCodes_ft to cInMemoryLogs_100_010_FormatErrorCodesAll_ft"
  },
  "ignoreEmpty": "true",
  "sources": {
    "source": {
      "-nameref": "cInMemoryLogs_100_010_FormatErrorCodesAll_ft"
    }
  },
  "target": {
    "coordinates": {
      "-keepSourceOrder": "false",
      "coordinate": [
        {
          "-name": "Machine",
          "input": {
            "-nameref": "MACHINE"
          }
        },
        {
          "-name": "Date",
          "input": {
            "-nameref": "fx_Date"
          }
        }
      ]
    },
