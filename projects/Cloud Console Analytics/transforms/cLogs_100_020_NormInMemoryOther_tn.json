          "input": {
            "-nameref": "fx_MarkerConversion"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "User Login",
          "-type": "integer",
          "input": {
            "-nameref": "fx_Login"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "User Logout",
          "-type": "integer",
          "input": {
            "-nameref": "fx_Logout"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Database Delayed Loading",
          "-type": "integer",
          "input": {
            "-nameref": "fx_DelayLoading"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Databases",
          "-type": "integer",
          "input": {
            "-nameref": "fx_DatabaseCount"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Databases size",
          "-type": "integer",
          "input": {
            "-nameref": "fx_DatabaseSize"
          }
        }
      ]
    }
  }
