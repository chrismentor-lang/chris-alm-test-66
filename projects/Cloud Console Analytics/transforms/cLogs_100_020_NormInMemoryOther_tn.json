          "-type": "integer",
          "input": {
            "-nameref": "fx_WarningLogs"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "In-Memory Error Logs",
          "-type": "integer",
          "input": {
            "-nameref": "fx_ErrorLogs"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Excel Add-In needs update",
          "-type": "integer",
          "input": {
            "-nameref": "fx_ExcelAddIn"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Corrupted HTTP request",
          "-type": "integer",
          "input": {
            "-nameref": "fx_CorruptRequest"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "No HTTP request handler",
          "-type": "integer",
          "input": {
            "-nameref": "fx_NoHandler"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Cannot convert marker",
