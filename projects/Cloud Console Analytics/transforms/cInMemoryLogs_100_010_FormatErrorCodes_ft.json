          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  err_idx = _input1.indexOf('cannot convert marker');\n  if(err_idx >=0)\n  {\n\treturn 1;\n  }\n}\nelse\n  return 0;"
