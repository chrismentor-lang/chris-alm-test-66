      {
        "-name": "fx_Error",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  err_idx = _input1.indexOf('error code: ');\n  par_idx = _input1.indexOf('(parameter ');\n  if(err_idx >=0 && par_idx >= 0)\n  {\n\treturn _input1.substring(err_idx,par_idx);\n  }\n  else if(err_idx >=0)\n  {\n\treturn _input1.substring(err_idx,LOG.length());\n  }\n\treturn '';\n  \n}\nelse\n  return '';"
        }
      },
      {
        "-name": "fx_ErrorMsg",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-alias": "ERR",
            "-nameref": "fx_Error",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(ERR)\n{\n  err_idx = ERR.indexOf('description: ');\n  if(err_idx >=0)\n  {\n\treturn _input1.substring(err_idx+13,ERR.length());\n    }\n  else \n  {\n\treturn '';\n  }\n}\nelse\n  return '';"
        }
      },
      {
        "-name": "fx_ErrorCode",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-alias": "ERR",
            "-nameref": "fx_Error",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(ERR)\n{\n  err_idx = ERR.indexOf('error code: ');\n  des_idx = ERR.indexOf('description: ');\n  if(err_idx >=0)\n  {\n\tsub = ERR.substring(err_idx+12,des_idx);\n\treturn 'Error code '+sub.trim();\n    }\n  else \n  {\n\treturn '';\n  }\n}\nelse\n  return '';"
        }
