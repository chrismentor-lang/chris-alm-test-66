        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  db_idx = LOG.indexOf('delayed auto loading database');\n  if(db_idx>0)\n  {\n\treturn 1;\n  }\n}",
          "type": "int"
        }
      },
      {
        "-name": "fx_DelayLoadingDatabase",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
