            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  disk_idx = LOG.indexOf('Disk free space:');\n  if(disk_idx>0)\n  {\n\treturn LOG.substring(disk_idx+16,LOG.length());\n  }\n}"
        }
      },
      {
        "-name": "fx_Database",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  db_idx = LOG.indexOf('system] database');\n  size_idx = LOG.indexOf('disk size');\n  if(db_idx>0 && size_idx>0)\n  {\n\treturn LOG.substring(db_idx+18,size_idx-3);\n  }\n}",
          "type": "String"
        }
      },
      {
        "-name": "fx_DatabaseSize",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  db_idx = LOG.indexOf('system] database');\n  size_idx = LOG.indexOf('disk size');\n  if(db_idx>0 && size_idx>0)\n  {\n\tsize = LOG.substring(size_idx+10,LOG.length());\n\tmb_idx = size.indexOf(' MB');\n\tif(mb_idx>0)\n\t{\n\t  str = LOG.substring(size_idx+10,LOG.length()-3);\n\t  return str.toInteger();\n\t}\n\telse\n\t{\n\t  return \"size not in MB\";\n\t}\n  }\n}"
        }
      },
      {
        "-name": "fx_DelayLoading",
        "-type": "Groovy",
