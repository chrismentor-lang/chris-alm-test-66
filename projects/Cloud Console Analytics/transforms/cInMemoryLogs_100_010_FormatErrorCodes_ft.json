              "-type": "String"
            }
          ]
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(DBM==null)\n{\n  return null;\n}\nelse if(MCH+\"~\"==DBM)\n{\n  return null;\n}\nelse\n{\n  return 1;\n}",
          "type": "int"
        }
      },
