          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  db_idx = LOG.indexOf('delayed auto loading database');\n  if(db_idx>0)\n  {\n\treturn LOG.substring(db_idx+31,LOG.length()-1);\n  }\n}",
          "type": "String"
        }
      },
      {
        "-name": "fx_MachineDatabase",
        "-type": "Groovy",
        "inputs": {
          "input": [
            {
              "-nameref": "MACHINE",
              "-type": "String"
            },
            {
              "-alias": "DB",
              "-nameref": "fx_Database",
              "-type": "String"
            },
            {
              "-alias": "DL",
              "-nameref": "fx_DelayLoadingDatabase",
              "-type": "String"
            }
          ]
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if((DB==null||DB==\"\")&&(DL==null||DL==\"\"))\n{\n  return MACHINE+\"~\";\n}\nelse if(DB==null||DB==\"\")\n{\n  return MACHINE+\"_\"+DL;\n}\nelse\n{\n  return MACHINE+\"_\"+DB;\n}",
          "type": "String"
        }
      },
      {
