          "script": "if(LEVEL==\"error\")\n{\n  return 1;\n}\nelse\n{\n  return 0;\n}",
          "type": "int"
        }
      },
      {
        "-name": "fx_Login",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  user_idx = LOG.indexOf('] user');\n  login_idx = LOG.indexOf('logged in');\n  if(login_idx >=0)\n  {\n\tuser = LOG.substring(user_idx+8,login_idx-2);\n\tupper = user.toLowerCase();\n\tif(upper==\"admin\" || upper==\"_internal_suite\" || upper == \"etl\")\n\t{\n\t  return 0;\n\t}\n\telse\n\t{\n\t  return 1;\n\t}\n  }\n  else \n  {\n\treturn '';\n  }\n}\nelse\n  return '';",
          "type": "String"
        }
      },
      {
        "-name": "fx_Logout",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG)\n{\n  user_idx = LOG.indexOf('] user');\n  logout_idx = LOG.indexOf('logged out');\n  if(logout_idx >=0)\n  {\n\tuser = LOG.substring(user_idx+8,logout_idx-2);\n\tupper = user.toLowerCase();\n\tif(upper==\"admin\" || upper==\"_internal_suite\" || upper == \"etl\")\n\t{\n\t  return 0;\n\t}\n\telse\n\t{\n\t  return 1;\n\t}\n  }\n  else \n  {\n\treturn '';\n  }\n}\nelse\n  return '';",
          "type": "String"
        }
      },
      {
        "-name": "fx_DiskSpace",
        "-type": "Groovy",
        "inputs": {
