{
  "-name": "cSchedulerComp_300_045_NormScheduler_tn",
  "-type": "TableNormalization",
  "cache": "false",
  "comment": {
    "#cdata-section": "CHANGED"
  },
  "ignoreEmpty": "true",
  "sources": {
    "source": {
      "-nameref": "cSchedulerComp_300_035_TaskLookup_ft"
    }
  },
  "target": {
    "coordinates": {
      "-keepSourceOrder": "false",
      "coordinate": [
        {
          "-name": "Machine ${vCompany}",
          "input": {
            "-nameref": "MACHINE"
          }
        },
        {
          "-name": "Date",
          "input": {
            "-nameref": "fx_Date"
          }
        },
        {
          "-name": "Minutes",
          "input": {
            "-nameref": "fx_Min"
          }
        },
        {
          "-name": "Task ${vCompany}",
          "input": {
            "-nameref": "fx_TaskMachine"
          }
        },
        {
          "-name": "Project ${vCompany}",
          "input": {
            "-nameref": "fx_JobMachine"
          }
        }
      ]
    },
    "measures": {
      "-normalize": "Measure (Scheduler)",
      "-valuename": "#Value",
      "measure": [
        {
          "-aggregate": "sum",
          "-name": "Tasks initiated",
          "-type": "integer",
          "input": {
            "-nameref": "fx_JobInit"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Tasks finished",
          "-type": "integer",
          "input": {
            "-nameref": "fx_Finished"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Scheduler Warning Logs",
          "-type": "integer",
          "input": {
            "-nameref": "fx_WarningLogs"
          }
        },
        {
          "-aggregate": "sum",
          "-name": "Scheduler Error Logs",
          "-type": "integer",
          "input": {
            "-nameref": "fx_ErrorLogs"
          }
        }
      ]
    }
  }
}
