{
  "-name": "cSchedulerLogs_300_010_FormatScheduler_ft",
  "-type": "FieldTransform",
  "cache": "false",
  "comment": "CHANGED",
  "functions": {
    "function": [
      {
        "-name": "fx_Date",
        "-type": "DateFormat",
        "inputs": {
          "input": {
            "-nameref": "TIME_LOCAL"
          }
        },
        "parameters": {
          "sourceformat": "yyyy-MM-dd HH:mm:ss",
          "targetformat": "yyyy-MM-dd"
        }
      },
      {
        "-name": "fx_Time",
        "-type": "DateFormat",
        "inputs": {
          "input": {
            "-nameref": "TIME_LOCAL"
          }
        },
        "parameters": {
          "sourceformat": "yyyy-MM-dd HH:mm:ss",
          "targetformat": "HH:mm:ss"
        }
      },
      {
        "-name": "fx_JobInit",
        "-type": "Groovy",
        "comment": "if(LOG)\n{\n  job_idx = _input1.indexOf('Start job ');\n  if(job_idx >=0)\n  {\n\treturn 1;\n  }\n  else\n\treturn 0;\n  \n}\nelse\n  return 0;",
        "inputs": {
          "input": {
            "-nameref": "JOB",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(JOB=='Start job')\n{\n  return 1;\n}\nelse\n{\n  return 0;\n}"
        }
      },
      {
        "-name": "fx_Task",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "tsk_idx = LOG.indexOf(\"[\", LOG.indexOf(\"[\") + 1);\nif(tsk_idx>-1)\n{\n  tsk2_idx = LOG.indexOf(\"]\", LOG.indexOf(\"]\") + 1);\n  if(tsk2_idx>-1)\n  {\n\treturn _input1.substring(tsk_idx+1,tsk2_idx);\n  }\n  else\n  {\n\treturn null;\n  }\n}\nelse\n{\n  return null;\n}"
        }
      },
      {
        "-name": "fx_User",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "usi_idx = LOG.indexOf(\"ETL Job user \");\nif(usi_idx>-1)\n{\n  usr_idx = LOG.substring(usi_idx+13,LOG.length());\n  return usr_idx;\n}\nelse\n{\n  return null;\n}",
          "type": "String"
        }
      },
      {
        "-name": "fx_Project",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "loc_idx = LOG.indexOf(\"- ETL Job locator\");\nif(loc_idx>-1)\n{\n  job_idx = LOG.indexOf(\".jobs.\");\n  if(job_idx>-1)\n  {\n\treturn LOG.substring(loc_idx+18,job_idx);\n  }\n  else\n  {\n\treturn null;\n  }\n}\nelse\n{\n  return null;\n}"
        }
      },
      {
        "-name": "fx_Job",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "loc_idx = LOG.indexOf(\"- ETL Job locator\");\nif(loc_idx>-1)\n{\n  job_idx = LOG.indexOf(\".jobs.\");\n  if(job_idx>-1)\n  {\n\treturn LOG.substring(job_idx+6,LOG.length());\n  }\n  else\n  {\n\treturn null;\n  }\n}\nelse\n{\n  return null;\n}"
        }
      },
      {
        "-name": "fx_Finished",
        "-type": "Groovy",
        "inputs": {
          "input": [
            {
              "-nameref": "LOG",
              "-type": "String"
            },
            {
              "-nameref": "JOB",
              "-type": "String"
            }
          ]
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(JOB.trim()==\"finished\")\n{\n  return 1;\n}\nelse\n{\n  return 0;\n}",
          "type": "int"
        }
      },
      {
        "-name": "fx_LevelUpper",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LEVEL",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "txt = LEVEL.toUpperCase();\nreturn txt;",
          "type": "String"
        }
      },
      {
        "-name": "fx_WarningLogs",
        "-type": "Map",
        "inputs": {
          "input": {
            "-nameref": "fx_LevelUpper"
          }
        },
        "parameters": {
          "default": "0",
          "mapping": {
            "map": {
              "-from": "WARNING",
              "-to": "1"
            }
          }
        }
      },
      {
        "-name": "fx_ErrorLogs",
        "-type": "Groovy",
        "inputs": {
          "input": [
            {
              "-nameref": "LEVEL",
              "-type": "String"
            },
            {
              "-nameref": "LOG",
              "-type": "String"
            }
          ]
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "if(LOG==null||LOG==\"\"||LOG.length()<4)\n{\n  return 0;\n}\nelse if(LOG[0..3]==\"RROR\")\n{\n  return 1;\n}\nelse\n{\n  return 0;\n}",
          "type": "int"
        }
      },
      {
        "-name": "fx_Hour",
        "-type": "DateFormat",
        "inputs": {
          "input": {
            "-nameref": "fx_Time"
          }
        },
        "parameters": {
          "language": "en",
          "sourceformat": "HH:mm:ss",
          "targetformat": "HH"
        }
      },
      {
        "-name": "fx_Min",
        "-type": "DateFormat",
        "inputs": {
          "input": {
            "-nameref": "fx_Time"
          }
        },
        "parameters": {
          "language": "en",
          "sourceformat": "HH:mm:ss",
          "targetformat": "HH:mm"
        }
      },
      {
        "-name": "fx_Sec",
        "-type": "DateFormat",
        "inputs": {
          "input": {
            "-nameref": "fx_Time"
          }
        },
        "parameters": {
          "language": "en",
          "sourceformat": "HH:mm:ss",
          "targetformat": "HH:mm:ss"
        }
      },
      {
        "-name": "fx_Company",
        "-type": "Split",
        "inputs": {
          "input": {
            "-nameref": "MACHINE"
          }
        },
        "parameters": {
          "occurence": "2",
          "separator": "-"
        }
      },
      {
        "-name": "fx_TaskMachine",
        "-type": "Groovy",
        "inputs": {
          "input": [
            {
              "-nameref": "LOG",
              "-type": "String"
            },
            {
              "-nameref": "MACHINE",
              "-type": "String"
            }
          ]
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "tsk_idx = LOG.indexOf(\"[\", LOG.indexOf(\"[\") + 1);\nif(tsk_idx>-1)\n{\n  tsk2_idx = LOG.indexOf(\"]\", LOG.indexOf(\"]\") + 1);\n  if(tsk2_idx>-1)\n  {\n\treturn _input2+\"_\"+_input1.substring(tsk_idx+1,tsk2_idx);\n  }\n  else\n  {\n\treturn _input2+\"~\";\n  }\n}\nelse\n{\n  return _input2+\"~\";\n}"
        }
      },
      {
        "-name": "fx_UserMachine",
        "-type": "Groovy",
        "inputs": {
          "input": [
            {
              "-nameref": "LOG",
              "-type": "String"
            },
            {
              "-nameref": "MACHINE",
              "-type": "String"
            }
          ]
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "usi_idx = LOG.indexOf(\"ETL Job user \");\nif(usi_idx>-1)\n{\n  usr_idx = LOG.substring(usi_idx+13,LOG.length());\n  return MACHINE+\"_\"+usr_idx;\n}\nelse\n{\n  return null;\n}"
        }
      },
      {
        "-name": "fx_TaskName",
        "-type": "Groovy",
        "inputs": {
          "input": {
            "-nameref": "LOG",
            "-type": "String"
          }
        },
        "parameters": {
          "buffered": "true",
          "nullDefaults": "false",
          "script": "tsk_idx = LOG.indexOf(\"[\", LOG.indexOf(\"[\") + 1);\nif(tsk_idx>-1)\n{\n  tsk2_idx = LOG.indexOf(\"]\", LOG.indexOf(\"]\") + 1);\n  if(tsk2_idx>-1)\n  {\n\treturn _input1.substring(tsk_idx+1,tsk2_idx);\n  }\n  else\n  {\n\treturn null;\n  }\n}\nelse\n{\n  return null;\n}"
        }
      }
    ]
