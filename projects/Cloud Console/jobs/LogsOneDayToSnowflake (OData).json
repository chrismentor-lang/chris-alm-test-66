{
  "-name": "LogsOneDayToSnowflake (OData)",
  "-type": "Parallel",
  "comment": {
    "#cdata-section": "Please provide variable vFrom by entering the day you want to load into Snowflake."
  },
  "executions": {
    "execution": {
      "-nameref": "ODataLogsDayToSnowflake",
      "-parallel": "true",
      "-type": "job"
    }
  },
  "failStatus": "inherit",
  "variables": {
    "variable": {
      "-name": "vFrom",
      "default": "2025-01-23"
    }
  }
}
