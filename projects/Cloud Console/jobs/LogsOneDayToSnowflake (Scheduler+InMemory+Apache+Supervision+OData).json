{
  "-name": "LogsOneDayToSnowflake (Scheduler+InMemory+Apache+Supervision+OData)",
  "-type": "Parallel",
  "comment": {
    "#cdata-section": "Please provide variable vFrom by entering the day you want to load into Snowflake."
  },
  "executions": {
    "execution": [
      {
        "-nameref": "SchedulerLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "InMemoryLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "ApacheLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "ODataLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "SupervisionLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      }
    ]
  },
  "failStatus": "inherit",
  "variables": {
    "variable": {
      "-name": "vFrom",
      "default": "2024-09-16"
    }
  }
}
