{
  "-name": "LogsOneDayToSnowflake (Spreadsheet+Integrator)",
  "-type": "Parallel",
  "comment": {
    "#cdata-section": "Please provide variable vFrom by entering the day you want to load into Snowflake."
  },
  "executions": {
    "execution": [
      {
        "-nameref": "IntegratorLogsDayToSnowflakeNew",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "SpreadsheetLogsDayToSnowflakeNew",
        "-parallel": "true",
        "-type": "job"
      }
    ]
  },
  "failStatus": "inherit",
  "variables": {
    "variable": {
      "-name": "vFrom",
      "default": "2024-09-23"
    }
  }
}
