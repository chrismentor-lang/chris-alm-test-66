{
  "-name": "LogsOneDayToSnowflake (RPC+PSF+OData+InMemory)",
  "-type": "Parallel",
  "comment": {
    "#cdata-section": "Please provide variable vFrom by entering the day you want to load into Snowflake."
  },
  "executions": {
    "execution": [
      {
        "-nameref": "RPCLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "PSFLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "ODataLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      },
      {
        "-nameref": "InMemoryLogsDayToSnowflake",
        "-parallel": "true",
        "-type": "job"
      }
    ]
  },
  "failStatus": "inherit",
  "variables": {
    "variable": {
      "-name": "vFrom",
      "default": "2025-01-13"
    }
  }
}
