{
  "-name": "xcRevenuePlanning_statEstimatedRevenueDaily_cs",
  "-type": "CubeSlice",
  "comment": {
    "#cdata-section": "Retrieves the input for the total estimated revenue for the base scenario from the Revenue Planning cube for eventual deletion and reload.\n\n20260213: Estimated revenue is loaded at Version Estimate and Month ~"
  },
  "connection": {
    "-nameref": "cgLocal_statThinkerbell_jc"
  },
  "query": {
    "-mode": "exclude",
    "-randomPaths": "false",
    "cube": {
      "-name": "Revenue Planning"
    },
    "filter": {
      "condition": [
        {
          "#cdata-section": "Estimate",
          "-dimension": "Version",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Base",
          "-dimension": "Scenario",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Revenue",
          "-dimension": "Detail Revenue",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "Input",
          "-dimension": "Measure",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        },
        {
          "#cdata-section": "~",
          "-dimension": "Month",
          "-mode": "onlyBases",
          "-operator": "equal",
          "-type": "accept"
        }
      ]
    }
  }
}
