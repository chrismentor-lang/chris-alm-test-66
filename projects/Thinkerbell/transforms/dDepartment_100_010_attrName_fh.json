{
  "-name": "dDepartment_100_010_attrName_fh",
  "-type": "TreeFH",
  "comment": {
    "#cdata-section": "Initiates the top 2 levels of the All Departments hierarchy for the Department dimension and populates the attributes Name, ID_Name, Code, and Active for the base level."
  },
  "sources": {
    "source": {
      "-nameref": "dDepartment_100_000_ascID_tv"
    }
  },
  "target": {
    "attributes": {
      "attribute": [
        {
          "-name": "Name",
          "-type": "string"
        },
        {
          "-name": "ID_Name",
          "-type": "string"
        },
        {
          "-name": "Code"
        },
        {
          "-name": "Active"
        }
      ]
    },
    "levels": {
      "level": [
        {
          "input": {
            "-constant": "All Departments"
          }
        },
        {
          "attributes": {
            "attribute": [
              {
                "-name": "Name",
                "input": {
                  "-nameref": "DEPARTMENT_NAME"
                }
              },
              {
                "-name": "ID_Name",
                "input": {
                  "-nameref": "DEPARTMENT_ID_NAME"
                }
              },
              {
                "-name": "Code",
                "input": {
                  "-nameref": "DEPARTMENT_CODE"
                }
              },
              {
                "-name": "Active",
                "input": {
                  "-nameref": "DEPARTMENT_ACTIVE"
                }
              }
            ]
          },
          "input": {
            "-nameref": "DEPARTMENT_ID"
          }
        }
      ]
    }
  }
}
