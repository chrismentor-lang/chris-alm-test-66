### rule
{"active":true,"comment":"LOG||Planning Versions, Months||Actuals\n\n20260317: Introduced","position":1,"template":{"name":"Actual months","parameters":{"Time dimension":"Month","Version dimension":"Version","Version dimension attribute":"Actual Months"}}}
['${VersionDimension}':'${Version}','Month':{${Elements}}] = ['Version':'Actual']
### rule
{"active":true,"position":2}
['Version':'Estimate', 'Scenario':'Base', 'Month':'~', 'Detail Revenue':'Billing', 'Measure':'Input'] = IF(''['Version':'Actual', 'Scenario':'Base', 'Month':'~', 'Office':'~', 'Job Type':'~', 'Task Type':'~', 'Client Head':'~', 'Currency':'XXX', 'Detail Revenue':'Probability', 'Measure':'Input'] == "Committed", 1, IF(''['Version':'Actual', 'Scenario':'Base', 'Month':'~', 'Office':'~', 'Job Type':'~', 'Task Type':'~', 'Client Head':'~', 'Currency':'XXX', 'Detail Revenue':'Probability', 'Measure':'Input'] == "Very Likely",0.75,IF(''['Version':'Actual', 'Scenario':'Base', 'Month':'~', 'Office':'~', 'Job Type':'~', 'Task Type':'~', 'Client Head':'~', 'Currency':'XXX', 'Detail Revenue':'Probability', 'Measure':'Input'] == "Likely",0.5,IF(''['Version':'Actual', 'Scenario':'Base', 'Month':'~', 'Office':'~', 'Job Type':'~', 'Task Type':'~', 'Client Head':'~', 'Currency':'XXX', 'Detail Revenue':'Probability', 'Measure':'Input'] == "Stretch",0.25,0)))) * ''['Version':'Estimate', 'Detail Revenue':'By Client Head Active', 'Measure':'Adjusted']
### rule
{"active":false,"comment":"TESTING RULE ONLY - PLEASE DELETE","position":3}
['Measure':'Input'] = STET() * 1
### rule
{"active":true,"comment":"LOG||Scenario, Input||Base, Adjusted\n\n20260322: Introduced","position":4,"template":{"name":"Dimension element like","parameters":{"Dimension":"Scenario","Pattern":"^\\d+$"}}}
['Scenario':'${Element}', 'Measure':'Input', 'Detail Revenue':{'Revenue', 'New Business', 'Organic'}] = ['Scenario':'Base', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"LOG||Revenue Active","position":5}
['Detail Revenue':'Revenue Active'] = B:IF('#_Estimate'['#_Estimate_':'Active', 'Estimate':!'Estimate'] == "true", ['Detail Revenue':'Revenue'], STET())
### rule
{"active":true,"comment":"LOG||New Business Active","position":6}
['Detail Revenue':'New Business Active'] = B:IF('#_Estimate'['#_Estimate_':'Active', 'Estimate':!'Estimate'] == "true", ['Detail Revenue':'New Business'], STET())
### rule
{"active":true,"comment":"LOG||Organic Active","position":7}
['Detail Revenue':'Organic Active'] = B:IF('#_Estimate'['#_Estimate_':'Active', 'Estimate':!'Estimate'] == "true", ['Detail Revenue':'Organic'], STET())
### rule
{"active":true,"comment":"FX||Input, Adjustment||Average\n\n20260202: Introduced","position":8,"template":{"name":"Dimension element like","parameters":{"Dimension":"Currency","Pattern":"^([A-Z]{3}) > ([A-Z]{3})$"}}}
['Currency':'${Element}', 'Measure':{'Input', 'Adjustment'}] = B:
['Currency':'${Group1}'] *
    PALO.DATA("", "FX", 
        !'Version', 
        !'Month', 
        "Average", 
        "${Group1}", 
        "${Group2}", 
        "Input"
    )
