### rule
{"active":true,"comment":"LOG||Planning Versions, Months||Actuals\n\n20260303: Introduced","position":1,"template":{"name":"Actual months","parameters":{"Time dimension":"Month","Version dimension":"Version","Version dimension attribute":"Actual Months"}}}
['${VersionDimension}':'${Version}','Month':{${Elements}}] = B: ['Version':'Actual']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":2}
['PL Account':'Income/Billings %'] = ['PL Account':'Income']/(['PL Account':'Billings'])
### rule
{"active":true,"comment":"REF||Overhead Expenses, COP Split Offices||Ref:COP Split\n\n20260312: Introduced","position":3}
['PL Account'::'Overhead Expenses', 'Office'::'COP Split Offices', 'Measure':{'Input', 'Adjustment'}] = B:['Office':'67'] * 'COP Split'['Detail COP Split':'COP Split %', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"KPI||\n\n20260323: Updated the rule to include depreciation accounts\n20260303: Introduced","position":4}
['PL Account':'EBITDA %'] = (['PL Account':'Operating Profit'] + ['PL Account':'60210'] + ['PL Account':'60311'] + ['PL Account':'60512'])/ ['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":5}
['PL Account':'PBT/Income %'] = ['PL Account':'Operating Profit']/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":6}
['PL Account':'Staff Expenses/Income %'] = (['PL Account':'Staff Expenses'])/(['PL Account':'Income']+['PL Account':'Other Income'])
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":7}
['PL Account':'Total Staff/Income excluding Govt Assistance'] = (['PL Account':'Staff Expenses'] ) / ['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":8}
['PL Account':'Occupancy Expenses/Income %'] = (['PL Account':'Occupancy Expenses'])/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":9}
['PL Account':'Communication & IT Expenses/Income %'] = (['PL Account':'Communication & IT Expenses'])/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":10}
['PL Account':'All Other Overheads/Income %'] = (['PL Account':'All Other Overheads'])/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":11}
['PL Account':'Professional Expenses/Income %'] = (['PL Account':'Professional Expenses'])/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":12}
['PL Account':'Travel & Entertainment/Income %'] = (['PL Account':'Travel & Entertainment'])/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":13}
['PL Account':'Expenses/Income %'] = (['PL Account':'Expenses'])/['PL Account':'Income']
### rule
{"active":true,"comment":"KPI||\n\n20260303: Introduced","position":14}
['PL Account':'Margin Excluding Govt Assistance'] = (['PL Account':'Operating Profit'] - ['PL Account':'Other Income']) / ['PL Account':'Income']
### rule
{"active":true,"comment":"FX||Input, Adjustment||Conversion Type\n\n20260202: Introduced","position":15,"template":{"name":"Dimension element like","parameters":{"Dimension":"Currency","Pattern":"^([A-Z]{3}) > ([A-Z]{3})$"}}}
['Currency':'${Element}', 'Measure':{'Input', 'Adjustment'}] = B:
IF( // For accounts having a non-empty Conversion Type 
    '#_PL Account'['#_PL Account_':'Conversion Type'],
    // Divide the input currency by the exchange rate
    ['Currency':'${Group1}'] *
    PALO.DATA("", "FX", 
        !'Version', 
        !'Month', 
        '#_PL Account'['#_PL Account_':'Conversion Type'], 
        "${Group1}", 
        "${Group2}", 
        "Input"
    ), 
    CONTINUE()
)
