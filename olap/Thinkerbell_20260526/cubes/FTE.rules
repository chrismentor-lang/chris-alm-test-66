### rule
{"active":true,"comment":"REF||Billable Hours||Actual\n\n['Detail FTE':'Billable Hours', 'Version':'Actual', 'Measure':'Input'] = 'Resource Planning'['Version':'Plan', 'Detail Resource':'Billable', 'Job Type':'All Job Types', 'Job':'All Jobs', 'Currency':'XXX']\n\n20260406: Introduced.","position":2}
