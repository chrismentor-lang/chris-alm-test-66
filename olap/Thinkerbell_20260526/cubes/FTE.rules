### rule
{"active":true,"comment":"KPI||Utilisation||Actual||Input","position":6}
['Detail FTE':'Utilisation', 'Measure':'Input'] = ['Detail FTE':'Billable Hours'] / ['Detail FTE':'FTE Hours']
### rule
{"active":true,"comment":"CAL||FTE Hours||XXX||Input","position":7}
['Detail FTE':'FTE Hours', 'Measure':'Input'] = IF('#_Employee'['#_Employee_':'Freelancer', '#_LANGUAGE':'~'] == 1, ['Detail FTE':'FTE'] * 8, ['Detail FTE':'FTE'] * 7.6)
### rule
{"active":true,"comment":"CAL||Benchmark Hours||Input","position":8}
['Detail FTE':'Benchmark Hours', 'Measure':'Input'] = IF('#_Employee'['#_Employee_':'Freelancer', '#_LANGUAGE':'~'] == 1, ['Detail FTE':'FTE Hours'], ['Detail FTE':'FTE Hours'] * ['Detail FTE':'Benchmark', 'Day':'~', 'Version':'Actual'])
