### rule
{"active":true,"comment":"CALC||FTE||Estimate||XXX||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260717: Introduced.","position":2}
['Detail HR':'FTE', 'Currency':'XXX', 'Version':'Estimate', 'Measure':{'Input', 'Adjustment'}] = B:IF(OR((!'Month') == "~", RIGHT(!'Month', 2) == "-~"), null, IF('#_Month'['#_Month_':'Current', '#_LANGUAGE':'~'] == "1", ''['Detail HR':'FTE Change'] + ''['Detail HR':'FTE Change', 'Month':'~'], ''['Detail HR':'FTE Change', 'Month':CONCATENATE(!'Month', "_LTD")] + ''['Detail HR':'FTE Change', 'Month':'~']))
### rule
{"active":true,"comment":"REF||FTE||XXX|Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":3}
['Detail HR':'FTE', 'Currency':'XXX', 'Measure':{'Input', 'Adjustment'}] = B:IF(OR((!'Month') == "~", RIGHT(!'Month', 2) == "-~"), null, ''['Month':'#_Month'['#_Month_':'YearToDate FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'Detail HR':'FTE Change'])
### rule
{"active":true,"comment":"CALC||Salary||Employee||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260625: Introduced","position":4}
['Detail HR':'Salary', 'Currency':{'AUD', 'NZD'}, 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:['Detail HR':'FTE', 'Currency':'XXX'] * ['Detail HR':'Full Time Base Salary','Measure':'Adjusted']
### rule
{"active":true,"comment":"CALC||Hourly Rate||Estimate||Freelancer||AUD.NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":5}
['Detail HR':'Hourly Rate', 'Currency':{'AUD', 'NZD'}, 'Employee Type':'Freelancer', 'Version':'Estimate', 'Measure':{'Input', 'Adjustment'}] = B:IF(OR((!'Month') == "~", RIGHT(!'Month', 2) == "-~"), null, IF('#_Month'['#_Month_':'Current', '#_LANGUAGE':'~']=="1",
//DATEFORMAT(NOW(), "\Y-\m"), 
''['Detail HR':'Hourly Rate Change'] + ''['Detail HR':'Hourly Rate Change', 'Month':'~'], ''['Detail HR':'Hourly Rate Change', 'Month':CONCATENATE(!'Month', "_LTD")] + ''['Detail HR':'Hourly Rate Change', 'Month':'~']))
### rule
{"active":true,"comment":"REF||Hourly Rate||Freelancer||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":6}
['Detail HR':'Hourly Rate', 'Currency':{'AUD', 'NZD'}, 'Employee Type':'Freelancer', 'Measure':{'Input', 'Adjustment'}] = B:IF(OR((!'Month') == "~", RIGHT(!'Month', 2) == "-~"), null, ''['Month':'#_Month'['#_Month_':'YearToDate FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'Detail HR':'Hourly Rate Change'])
### rule
{"active":true,"comment":"CALC||Wages||Freelancer||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260725: Removed 'Scenario':'Base'  from target as it needs to be calculated on all scenarios.","position":7}
['Detail HR':'Wages', 'Employee Type':'Freelancer', 'Currency':{'AUD', 'NZD'}, 'Measure':{'Input', 'Adjustment'}] = B:['Currency':'XXX', 'Detail HR':'Hours'] * ['Detail HR':'Hourly Rate','Measure':'Adjusted']
### rule
{"active":true,"comment":"REF:HR Parameters||Payroll Tax||Employee||AUD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260725: Changed the rule to be specific for NZD referring to NZ to make sure that we don't need to do a lookup of the country in the employee dimension.\n20260625: Introduced","position":8}
['Detail HR':'Payroll Tax', 'Currency':'AUD', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:'HR Parameters'['Country':'AU', 'Detail HR Parameters':'Payroll Tax %'] * ['Detail HR':'Salary', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"REF:HR Parameters||Payroll Tax||Employee||NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20270725: Introduced.","position":9}
['Detail HR':'Payroll Tax', 'Currency':'NZD', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:'HR Parameters'['Country':'NZ', 'Detail HR Parameters':'Payroll Tax %'] * ['Detail HR':'Salary', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"REF:HR Parameters||Superannuation||Employee||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260625: Introduced","position":10}
['Detail HR':'Superannuation', 'Currency':'AUD', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:MIN('HR Parameters'['Country':'AU', 'Detail HR Parameters':'Superannuation % / KiwiSaver %', 'Measure':'Adjusted'] * ['Detail HR':'Salary'], 2500)
### rule
{"active":true,"comment":"REF: HR Parameters||Superannuation||Employee||NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":11}
['Detail HR':'Superannuation', 'Currency':'NZD', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:'HR Parameters'['Country':'NZ', 'Detail HR Parameters':'Superannuation % / KiwiSaver %', 'Measure':'Adjusted'] * ['Detail HR':'Salary', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"REF: HR Parameters||WorkCover||Employee||AUD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260625: Introduced","position":12}
['Detail HR':'Workcover', 'Currency':'AUD', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:'HR Parameters'['Country':'AU', 'Detail HR Parameters':'Workcover %', 'Measure':'Adjusted'] * ['Detail HR':'Salary', 'Measure':'Adjusted']
