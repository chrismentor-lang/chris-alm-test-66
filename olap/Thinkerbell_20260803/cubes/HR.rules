{"active":true,"comment":"REF: HR Parameters||Workcover||Employee||NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":13}
['Detail HR':'Workcover', 'Currency':'NZD', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:'HR Parameters'['Country':'NZ', 'Detail HR Parameters':'Workcover %', 'Measure':'Adjusted'] * ['Detail HR':'Salary', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"LOG||Headcount||XXX||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260725: Changed Measure:: Base to Input in target. Added Measure: Adjusted to source.\n20260625: Introduced","position":14}
['Detail HR':'Headcount', 'Currency':'XXX', 'Measure':{'Input', 'Adjustment'}] = B: IF(['Detail HR':'FTE','Measure':'Adjusted'], 1, null)
### rule
{"active":true,"comment":"REF||Full Time Base Salary||Estimate||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260625: Introduced","position":15}
['Detail HR':'Full Time Base Salary', 'Version':'Estimate','Currency':{'AUD', 'NZD'}, 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:IF(OR(!'Month' == "~", RIGHT(!'Month', 2) == "-~"), null, (''['Month':!'Month'|"_LTD", 'Detail HR':'Full Time Base Salary (Change)']))
### rule
{"active":true,"comment":"CALC||Full Time Base Salary||Employee||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":16}
['Detail HR':'Full Time Base Salary', 'Currency':{'AUD', 'NZD'}, 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:IF(OR(!'Month' == "~", RIGHT(!'Month', 2) == "-~"), null, ''['Month':CONCATENATE(LEFT('#_Month'['#_Month_':'Fiscal Year Element', '#_LANGUAGE':'~'], 9), "_YTD"), 'Detail HR':'Full Time Base Salary (Change)']-''['Month':CONCATENATE(LEFT('#_Month'['#_Month_':'Fiscal Year Element', '#_LANGUAGE':'~'], 6), "-~"), 'Detail HR':'Full Time Base Salary (Change)'])
### rule
{"active":true,"comment":"REF||Non-Base||Input\n\n20260727: Introduced to retrieve the Base for each of the scenarios.","position":17,"template":{"name":"Dimension element like","parameters":{"Dimension":"Scenario","Pattern":"^\\d+$"}}}
['Scenario':'${Element}', 'Measure':'Input'] = ['Scenario':'Base', 'Measure':'Adjusted']
### rule
{"active":true,"comment":"STET||Full Time Base Salary (Change)||Estimate||Employee||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.","position":18}
['Detail HR':'Full Time Base Salary (Change)', 'Currency':{'AUD', 'NZD'}, 'Version':'Estimate', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:IF('#_Month'['#_Month_':'History', '#_LANGUAGE':'~']=="1",
//DATEFORMAT(NOW(), "\Y-\m")), 
STET(), CONTINUE())
### rule
{"active":true,"comment":"CALC||Full Time Base Salary (Change)||Estimate||Employee||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260717: Introduced.","position":19}
['Detail HR':'Full Time Base Salary (Change)', 'Currency':{'AUD', 'NZD'}, 'Version':'Estimate', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B: IF(!'Month' != "~", IF('#_Month'['#_Month_':'Current', '#_LANGUAGE':'~']=="1",
//DATEFORMAT(NOW(), "\Y-\m"), 
(''['Month':'~', 'Detail HR':'Full Time Base Salary (Change)'] + (''['Month':'~', 'Detail HR':'Full Time Base Salary (Change)','Measure':'Adjusted'] * ['Salary Change %']) + ['Salary Change Absolute']), (''['Month':'#_Month'['#_Month_':'PreviousMonth LTD', '#_LANGUAGE':'~'], 'Detail HR':'Full Time Base Salary (Change)','Measure':'Adjusted']) * ['Salary Change %'] + ['Salary Change Absolute']), STET())
### rule
{"active":true,"comment":"CALC||Full Time Base Salary (Change)||Budget,Forecast||Employee||AUD,NZD||Input\n\n20260727: Changed rule target Input to {'Input', 'Adjustment'}.\n20260720: ['HR Detail':'Full Time Base Salary (Change)', 'Currency':{'AUD', 'NZD'}, 'Version':'${Element}', 'Employee Type':'Employee', 'Measure':'Input'] = B:IF(!'Month' != \"~\", IF(PALO.DATA(\"\", \"#_Month\", \"PreviousMonth\", !'Month', \"~\") != \"\", IF(RIGHT(!'Month', 2) == '#_Version'['#_Version_':'First Forecast Calendar Month', '#_LANGUAGE':'~'], ''['Month':'#_Month'['#_Month_':'Default FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'HR Detail':'Full Time Base Salary (Change)'] + ((''['Month':'#_Month'['#_Month_':'Default FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'HR Detail':'Full Time Base Salary (Change)'] * ['Salary Change %']) + ['Salary Change Absolute']), ((''['Month':'#_Month'['#_Month_':'PreviousMonth YearToDate FY', '#_LANGUAGE':'~'], 'HR Detail':'Full Time Base Salary (Change)'] - ''['Month':'#_Month'['#_Month_':'Default FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'HR Detail':'Full Time Base Salary (Change)']) * ['Salary Change %']) + ['Salary Change Absolute']), STET()), STET())","position":20,"template":{"name":"Dimension element like","parameters":{"Dimension":"Version","Pattern":"^Forecast|Budget"}}}
['Detail HR':'Full Time Base Salary (Change)', 'Currency':{'AUD', 'NZD'}, 'Version':'${Element}', 'Employee Type':'Employee', 'Measure':{'Input', 'Adjustment'}] = B:IF(!'Month' != "~", IF(PALO.DATA("", "#_Month", "PreviousMonth", !'Month', "~") != "", IF(RIGHT(!'Month', 2) == '#_Version'['#_Version_':'First Forecast Calendar Month', '#_LANGUAGE':'~'], ''['Month':'#_Month'['#_Month_':'Default FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'Detail HR':'Full Time Base Salary (Change)'] + ((''['Month':'#_Month'['#_Month_':'Default FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'Detail HR':'Full Time Base Salary (Change)','Measure':'Adjusted'] * ['Salary Change %']) + ['Salary Change Absolute']), ((''['Month':'#_Month'['#_Month_':'PreviousMonth YearToDate FY', '#_LANGUAGE':'~'], 'Detail HR':'Full Time Base Salary (Change)'] - ''['Month':'#_Month'['#_Month_':'Default FY', '#_LANGUAGE':'~', 'Month':!'Month'], 'Detail HR':'Full Time Base Salary (Change)','Measure':'Adjusted']) * ['Salary Change %']) + ['Salary Change Absolute']), STET()), STET())
