### rule
{"active":true,"comment":"Gross Sales | Sales Monthly  | Budget, Forecast","position":1}
['Currency':'AUD', 'Version':{'Budget', 'Forecast'}, 'PL Account':'4001', 'Measure_PL':'Value'] = B:IF(ISERROR('Monthly Sales'['Product':'All Products', 'Customer':'#_Cost Centre'['#_Cost Centre_':'Sales Region'], 'Measure_Sales':'Gross Sales (excl GST)']), null, 'Monthly Sales'['Product':'All Products', 'Customer':'#_Cost Centre'['#_Cost Centre_':'Sales Region'], 'Measure_Sales':'Gross Sales (excl GST)'])
### rule
{"active":true,"comment":"Discounts| Sales Monthly  | Budget, Forecast","position":2}
['Currency':'AUD', 'Version':{'Budget', 'Forecast'}, 'PL Account':'4002', 'Measure_PL':'Value'] = B:
// Get Discounts from Sales monthly cube
IF(
ISERROR('Monthly Sales'['Product':'All Products', 'Customer':'#_Cost Centre'['#_Cost Centre_':'Sales Region'], 'Measure_Sales':'Discount']), null, 'Monthly Sales'['Product':'All Products', 'Customer':'#_Cost Centre'['#_Cost Centre_':'Sales Region'], 'Measure_Sales':'Discount']
)
